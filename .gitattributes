* text=auto eol=lf

# Generated project and documentation output should not dominate language or
# contribution views. Their source remains project.yml and HelpCenter/.
Crest.xcodeproj/** linguist-generated=true
Website/guides/** linguist-generated=true

# Keep user-facing documentation and site sources visible to GitHub Linguist.
Documentation/** linguist-documentation=true
HelpCenter/docs/** linguist-documentation=true

# A unified patch's blank context line is one space, required by its format.
CrestEngines/Chromium/Patches/*.patch whitespace=-blank-at-eol

# Preserve downloaded filter sources exactly as recorded by their SHA-256 hashes.
ThirdParty/FennavioFilters/Sources/*.txt -text -whitespace

# Preserve the verified upstream API release bytes, including its line endings.
CrestMobile/Resources/DarkReader.js -text -whitespace
